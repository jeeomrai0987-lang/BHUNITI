# FastAPI Server Settings
PROJECT_NAME=BHUNITI Land Governance Platform API
API_V1_STR=/api/v1
# Generate your own before running anywhere but a laptop:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# The service logs a warning while this is still the shipped default value.
SECRET_KEY=bhuniti_secret_jwt_key_super_secure_development_key_12345
ACCESS_TOKEN_EXPIRE_MINUTES=1440
ENVIRONMENT=development

# Internationalisation
# DEFAULT_LOCALE is used when a request sends neither ?lang= nor Accept-Language.
# SUPPORTED_LOCALES must match the catalogs in app/i18n/locales/.
DEFAULT_LOCALE=en
SUPPORTED_LOCALES=en,hi,mr,bn,ta

# CORS. Either spelling works: a comma-separated list (below) or a JSON array
# (["http://localhost:5173","http://localhost:3000"]).
BACKEND_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000,http://127.0.0.1:3000
# Optional regex for preview deployments, e.g. https://.*\.vercel\.app
CORS_ORIGIN_REGEX=

# Supabase credentials
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-supabase-anon-or-service-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# PostgreSQL direct connection string (Supabase -> Project Settings -> Database).
# Session mode is port 5432; transaction mode is port 6543.
# Leave DATABASE_URL empty to run entirely on the local SQLite file below.
DATABASE_URL=postgresql+asyncpg://postgres:your_password@db.your-project.supabase.co:5432/postgres
# Local fallback, used when DATABASE_URL is empty or Postgres is unreachable.
SQLITE_DB_PATH=./bhuniti_local.db
USE_SQLITE_FALLBACK=True

# EmailJS Configuration (Single delivery channel for all OTPs & Officer Credentials)
EMAILJS_SERVICE_ID=service_xxxxxxx
EMAILJS_TEMPLATE_ID_OTP=template_xxxxxxx
EMAILJS_TEMPLATE_ID_OFFICER_CREDENTIALS=template_xxxxxxx
EMAILJS_PUBLIC_KEY=your_emailjs_public_key
EMAILJS_PRIVATE_KEY=your_emailjs_private_key

# Presentation Safety Net (Set to true to return otp_code in API responses for on-screen fallback)
DEMO_MODE=false

# PII & Aadhaar Security Salt
AADHAAR_HASH_SALT=bhuniti_secure_aadhaar_salt_2026_sih
SMS_GATEWAY_API_KEY=

# Optional: Dual-Database Mirroring & Sync Script Configuration
# DB1_HOST=db.your-primary.supabase.co
# DB1_PORT=5432
# DB1_USER=postgres
# DB1_PASS=your_primary_password
# DB1_NAME=postgres
# DB2_HOST=aws-0-your-region.pooler.supabase.com
# DB2_PORT=5432
# DB2_USER=postgres.your-secondary-project-ref
# DB2_PASS=your_secondary_password
# DB2_NAME=postgres

