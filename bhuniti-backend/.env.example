# FastAPI Server Settings
PROJECT_NAME=BHUNITI Land Governance Platform
API_V1_STR=/api/v1
# Generate a cryptographically secure key before running anywhere:
#   python -c "import secrets; print(secrets.token_hex(32))"
# The service will refuse to start in production/staging if this is set to the development default.
SECRET_KEY=your-secret-jwt-key-here-min-32-chars
ACCESS_TOKEN_EXPIRE_MINUTES=1440
ENVIRONMENT=development

# Internationalisation
# DEFAULT_LOCALE is used when a request sends neither ?lang= nor Accept-Language.
# SUPPORTED_LOCALES must match the catalogs in app/i18n/locales/.
DEFAULT_LOCALE=en
SUPPORTED_LOCALES=en,hi,mr,bn,ta

# CORS Configuration. Accepts a comma-separated list or JSON array.
# Add your deployed frontend URL here once known, e.g. https://your-app.vercel.app — requests from origins not listed here will be blocked by the browser.
BACKEND_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000,http://127.0.0.1:3000
# Optional regex for preview deployments, e.g. https://.*\.vercel\.app
CORS_ORIGIN_REGEX=

# Supabase credentials
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-supabase-anon-or-service-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# PostgreSQL connection string (Supabase -> Project Settings -> Database).
# In production on Render/containers, set USE_SQLITE_FALLBACK=False so a database outage
# raises a loud connection error rather than silently writing to ephemeral local disk.
DATABASE_URL=postgresql+asyncpg://user:password@host:5432/dbname
SQLITE_DB_PATH=./bhuniti_local.db
# Set USE_SQLITE_FALLBACK=False in production! (Default True is for local offline dev only)
USE_SQLITE_FALLBACK=False

# EmailJS Configuration (Single delivery channel for all OTPs & Officer Credentials)
EMAILJS_SERVICE_ID=your-emailjs-service-id-here
EMAILJS_TEMPLATE_ID_OTP=your-emailjs-template-id-otp-here
EMAILJS_TEMPLATE_ID_OFFICER_CREDENTIALS=your-emailjs-template-id-officer-credentials-here
EMAILJS_PUBLIC_KEY=your-emailjs-public-key-here
EMAILJS_PRIVATE_KEY=your-emailjs-private-key-here

# Presentation Safety Net (Set to true to return otp_code in API responses for on-screen fallback)
DEMO_MODE=false

# PII & Aadhaar Security Salt
AADHAAR_HASH_SALT=your-aadhaar-hash-salt-here
SMS_GATEWAY_API_KEY=

# Optional: Dual-Database Mirroring & Sync Script Configuration
# DB1_HOST=db.your-primary.supabase.co
# DB1_PORT=5432
# DB1_USER=postgres
# DB1_PASS=your-primary-password-here
# DB1_NAME=postgres
# DB2_HOST=aws-0-your-region.pooler.supabase.com
# DB2_PORT=5432
# DB2_USER=postgres.your-secondary-project-ref
# DB2_PASS=your-secondary-password-here
# DB2_NAME=postgres

