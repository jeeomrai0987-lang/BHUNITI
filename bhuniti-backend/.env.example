# FastAPI Server Settings
PROJECT_NAME=BHUNITI Land Governance Platform API
API_V1_STR=/api/v1
SECRET_KEY=bhuniti_secret_jwt_key_super_secure_development_key_12345
ACCESS_TOKEN_EXPIRE_MINUTES=1440
ENVIRONMENT=development

# CORS Settings (comma-separated origins)
BACKEND_CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173","http://localhost:3000"]

# Supabase Credentials (Provided by user)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-supabase-anon-or-service-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# PostgreSQL Direct Connection String (from Supabase Database settings)
# For Supabase, use Session mode on port 5432 or Transaction mode on port 6543
DATABASE_URL=postgresql+asyncpg://postgres:your_password@db.your-project.supabase.co:5432/postgres
# Fallback SQLite DB for local development if Supabase credentials are not yet entered
SQLITE_DB_PATH=./bhuniti_local.db
USE_SQLITE_FALLBACK=True
